# Copy to .env and adjust. All variables are optional except the Telegram token for the worker.

# Development: SQLite file next to the project. Before the MVP: PostgreSQL (asyncpg driver, D-003).
DATABASE_URL=sqlite+aiosqlite:///./reminder.db
# DATABASE_URL=postgresql+asyncpg://reminder:password@db-host:5432/reminder
# PostgreSQL: put tables into this schema (created by `reminder migrate`). Needed when the role
# may not create objects in `public` (default since PostgreSQL 15).
# DATABASE_SCHEMA=reminder
DATABASE_ECHO=false

# Telegram bot token from @BotFather (required for `reminder worker`).
TELEGRAM_BOT_TOKEN=
# Access is stored in the database (D-020). Bootstrap the first admin after migrate:
#   uv run reminder admin grant <chat_id>   (the bot tells an unknown chat its id)

# Timezone for new users (they can change it with /timezone).
DEFAULT_TIMEZONE=Europe/Moscow

WORKER_TICK_SECONDS=30
WORKER_GRACE_MINUTES=120

API_HOST=127.0.0.1
API_PORT=8000

LOG_LEVEL=INFO
